# --- Base de datos (Postgres, gestionada por docker-compose) ---
# En docker-compose el host es "db".
DATABASE_URL=postgres://devboard:devboard@db:5432/devboard

# --- Servidor ---
PORT=8092
NODE_ENV=production

# --- Sesión ---
# Secreto usado para firmar la cookie de sesión (HMAC). Generar uno propio, p.ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-secreto-por-uno-aleatorio-de-al-menos-32-caracteres

# --- Autenticación ---
# Contraseña del rol "tl" (obligatoria).
TL_PASSWORD=cambia-esta-contrasena
# Contraseña del rol "viewer". Si se deja vacía, las vistas públicas no piden contraseña.
VIEWER_PASSWORD=

# --- Integración Jira (opcional; sin esto, la sincronización de Jira no hace nada) ---
JIRA_BASE_URL=https://tu-empresa.atlassian.net
JIRA_EMAIL=tu-email@ejemplo.com
JIRA_API_TOKEN=
JIRA_PROJECT=PROJ
# 'basic' (por defecto): Authorization Basic con JIRA_EMAIL + API token clásico
# (https://id.atlassian.com/manage-profile/security/api-tokens). Es lo habitual.
# 'bearer': Authorization Bearer JIRA_API_TOKEN, para integraciones OAuth 2.0 (3LO); en ese
# caso JIRA_EMAIL no es necesario.
JIRA_AUTH_MODE=basic

# --- Integración GitHub (opcional; sin esto, la sincronización de GitHub no hace nada) ---
GITHUB_TOKEN=
GITHUB_ORG=tu-org-de-github
# Repos a sincronizar, separados por coma (sin el nombre de la org), p.ej.: api,web,infra
GITHUB_REPOS=

# --- Sincronización ---
# Minutos entre cada ejecución automática del scheduler.
SYNC_MINUTES=30
# Fecha desde la que se sincronizan issues/PRs (formato YYYY-MM-DD). Opcional.
SINCE_DATE=2024-01-01

# --- Postgres (usado por el servicio "db" de docker-compose) ---
POSTGRES_USER=devboard
POSTGRES_PASSWORD=devboard
POSTGRES_DB=devboard
